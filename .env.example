# Project Settings / API: public publishable key, never a service-role secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is accepted if PUBLISHABLE_KEY is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Trusted app origin for magic-link redirects; defaults to localhost:3000 in dev.
# Required for production. No trailing path. Use HTTPS when deployed.
APP_URL=http://localhost:3000
# SERVER ONLY: enables the user-confirmed account deletion workflow.
# Use a Supabase secret key, or the legacy service_role key below. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Random server-only bearer secret for /api/account/purge scheduled retries.
CRON_SECRET=
